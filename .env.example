# ---------- Vobiz (your number + SIP trunk) ----------
# Console: https://console.vobiz.ai  ->  SIP Trunk > Outbound Trunks > Trunks
VOBIZ_AUTH_ID=MA_XXXXXXXX
VOBIZ_AUTH_TOKEN=
# Auto-generated when the trunk is created: <trunk_id>.sip.vobiz.ai
VOBIZ_SIP_DOMAIN=
# The credential username/password you created under "Authentication & Linking".
# NOTE: this is NOT your dashboard display name -- using the display name returns 401.
VOBIZ_SIP_USERNAME=
VOBIZ_SIP_PASSWORD=
# Your Vobiz number in E.164, used as outbound caller ID and inbound route.
VOBIZ_PHONE_NUMBER=+91XXXXXXXXXX

# ---------- LiveKit ----------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Filled in by provision.py
LIVEKIT_OUTBOUND_TRUNK_ID=

# ---------- AI providers ----------
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
RAYA_API_KEY=

# ---------- Model / latency tuning ----------
# claude-opus-5 is the default and the most capable.
# If you cannot hit your latency target with it, claude-haiku-4-5 is the
# lowest-time-to-first-token option -- one env var flip, no code change.
# See README "Latency" for the honest budget before changing this.
LLM_MODEL=claude-opus-5
LLM_EFFORT=low
CARTESIA_VOICE_ID=794f9389-aac1-45b6-b726-9d9369183238
